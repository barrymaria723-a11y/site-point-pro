---
// Champ mot de passe avec bouton pour l'afficher
const { id, label, ...reste } = Astro.props;
---
<div class="champ"><label for={id}>{label}</label>
<div class="secret"><input id={id} name={id} type="password" required {...reste}><button type="button" class="oeil" data-pour={id} aria-label={`Afficher : ${label}`} aria-pressed="false"><svg aria-hidden="true" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/><path class="barre" d="M4 4l16 16"/></svg></button></div></div>
