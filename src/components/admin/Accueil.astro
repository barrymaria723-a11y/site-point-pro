---
// Écran en deux parties : marque à gauche, formulaire à droite
const { titre, texte, points = [] } = Astro.props;
---
<div class="ecran">
<aside class="marque">
<picture><source type="image/avif" srcset="/images/briqueterie-stock-hangar.avif"><img class="fond" src="/images/briqueterie-stock-hangar.jpg" alt=""></picture>
<a class="logo" href="/"><picture><source type="image/avif" srcset="/images/logo-embleme.avif"><img src="/images/logo-embleme.png" alt="" width="52" height="52"></picture><span>POINT PRO GUINÉE<small>Espace privé</small></span></a>
<div class="propos"><h2>{titre}</h2>{texte && <p>{texte}</p>}
{points.length > 0 && <ul>{points.map((p) => <li><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#E8892B" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span>{p}</span></li>)}</ul>}</div>
</aside>
<main class="saisie"><div class="boite"><slot /></div></main>
</div>
