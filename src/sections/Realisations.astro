---
import Galerie from '../components/vue/Galerie.vue';

const GALLERY = [
  {
    "src": "briqueterie-parc-stockage.jpg",
    "alt": "Parc de stockage : parpaings sur palettes",
    "texte": "Briqueterie · parc de stockage",
    "style": "object-position:center 42%"
  },
  {
    "src": "transport-camion-benne.jpg",
    "alt": "Camion benne chargé de parpaings",
    "texte": "Transport · camion benne"
  },
  {
    "src": "transport-semi-remorque.jpg",
    "alt": "Semi-remorque avec conteneur au port",
    "texte": "Transport · semi-remorque",
    "style": "object-position:center 40%"
  },
  {
    "src": "pondeuse-production.jpg",
    "alt": "Pondeuse en production",
    "texte": "Briqueterie · pondeuse"
  },
  {
    "src": "parpaings-sortie-pondeuse.jpg",
    "alt": "Parpaings creux à la sortie de la pondeuse",
    "texte": "Briqueterie · parpaings creux"
  }
];
---
<section class="section" id="realisations"><div class="wrap">
<div class="section-head reveal"><div class="eyebrow">Sur le terrain</div><h2>La force du concret.</h2><p>Nos chantiers, nos engins et notre production. Cette galerie s’enrichira au fil de nos réalisations.</p></div>
<Galerie client:load classe="gallery" images={GALLERY} />
</div></section>
