---
import Base from '../layouts/Base.astro';
import Formulaire from '../components/vue/Formulaire.vue';
---
<Base page="contact" titre="Contact & devis — POINT PRO GUINÉE" description="Décrivez votre besoin : votre demande arrive directement sur notre WhatsApp.">
<section class="page-hero"><picture><source type="image/avif" srcset="/images/transport-semi-remorque-640.avif 640w, /images/transport-semi-remorque.avif 764w" sizes="(max-width: 700px) 50vw, 100vw"><img class="hero-bg" src="/images/transport-semi-remorque.jpg" alt="" aria-hidden="true"></picture><div class="page-hero-inner">
<nav class="crumbs" aria-label="Fil d’Ariane"><a href="/">Accueil</a><span aria-hidden="true">/</span><span aria-current="page">Contact &amp; devis</span></nav>
<h1>Contact &amp; devis</h1>
<p>Décrivez votre besoin : votre demande arrive directement sur notre WhatsApp.</p>
</div></section>
<section class="section soft" id="contact"><div class="wrap">
<div class="section-head reveal"><div class="eyebrow">Contact &amp; devis</div><h2>Parlons de votre projet.</h2><p>Décrivez votre besoin : notre équipe recevra votre demande directement sur WhatsApp.</p></div>
<div class="contact-grid contact-solo">
<div class="reveal"><Formulaire client:load /></div>
</div>
</div></section>
</Base>
