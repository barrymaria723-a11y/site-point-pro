---
import Admin from '../../layouts/Admin.astro';
import Accueil from '../../components/admin/Accueil.astro';
import Secret from '../../components/admin/Secret.astro';
import { autoriser, liberer } from '../../server/base.js';
import { MDP_MAX, MDP_MIN, bonMotDePasse, changerMotDePasse, connecte, empreinte, ouvrirSession } from '../../server/securite.js';
import { proteger } from '../../server/entetes.js';

export const prerender = false;
proteger(Astro.response);

let erreur = '';
const refuser = (code, texte) => { Astro.response.status = code; erreur = texte; };
try {
  if (!(await connecte(Astro.cookies))) return Astro.redirect('/admin', 303);
  if (Astro.request.method === 'POST') {
    const f = await Astro.request.formData();
    const actuel = String(f.get('actuel') ?? ''), nouveau = String(f.get('nouveau') ?? ''), encore = String(f.get('encore') ?? '');
    const cle = empreinte('mdp', Astro.clientAddress);
    if (nouveau.length < MDP_MIN) refuser(400, `Le nouveau mot de passe doit contenir au moins ${MDP_MIN} caractères.`);
    else if (nouveau.length > MDP_MAX) refuser(400, `Le nouveau mot de passe ne doit pas dépasser ${MDP_MAX} caractères.`);
    else if (new Set(nouveau).size < 5) refuser(400, 'Le nouveau mot de passe est trop simple : variez les caractères.');
    else if (nouveau !== encore) refuser(400, 'Les deux nouveaux mots de passe sont différents.');
    else if (nouveau === actuel) refuser(400, 'Le nouveau mot de passe doit être différent de l’actuel.');
    else if (!(await autoriser(cle, 5, 900))) refuser(429, 'Trop d’essais. Réessayez dans 15 minutes.');
    else if (!(await bonMotDePasse(actuel))) refuser(401, 'Le mot de passe actuel est incorrect.');
    else {
      await changerMotDePasse(nouveau);
      await liberer(cle);
      await ouvrirSession(Astro.cookies);
      return Astro.redirect('/admin?mdp=ok', 303);
    }
  }
} catch (e) {
  console.error('mot de passe :', e.message);
  refuser(503, 'La base de données ne répond pas. Votre mot de passe n’a pas été changé.');
}
---
<Admin titre="Changer le mot de passe">
<Accueil titre="Gardez votre espace en sécurité." points={['Le nouveau mot de passe marche tout de suite.', 'Les autres appareils connectés sont déconnectés.', 'Une phrase facile à retenir convient très bien.']}>
<a class="retour" href="/admin"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>Retour aux demandes</a>
<h1>Changer le mot de passe</h1>
<p class="intro-page">Entrez l’actuel, puis choisissez le nouveau.</p>
{erreur && <p class="erreur" role="alert">{erreur}</p>}
<form method="post">
<Secret id="actuel" label="Mot de passe actuel" maxlength={MDP_MAX} autocomplete="current-password" />
<div class="bloc-nouveau">
<Secret id="nouveau" label="Nouveau mot de passe" minlength={MDP_MIN} maxlength={MDP_MAX} autocomplete="new-password" aria-describedby="regles" />
<Secret id="encore" label="Répétez le nouveau mot de passe" minlength={MDP_MIN} maxlength={MDP_MAX} autocomplete="new-password" />
<ul class="regles" id="regles"><li id="r-long">Au moins {MDP_MIN} caractères</li><li id="r-varie">Des caractères variés</li><li id="r-egal">Les deux saisies sont identiques</li></ul>
</div>
<button class="plein">Changer le mot de passe</button>
</form>
</Accueil>
<script is:inline define:vars={{ MDP_MIN }}>(function(){var n=document.getElementById('nouveau'),e=document.getElementById('encore');function m(i,ok){document.getElementById(i).classList.toggle('ok',ok)}function v(){m('r-long',n.value.length>=MDP_MIN);m('r-varie',new Set(n.value).size>=5);m('r-egal',n.value!==''&&n.value===e.value)}n.addEventListener('input',v);e.addEventListener('input',v)})();</script>
</Admin>
