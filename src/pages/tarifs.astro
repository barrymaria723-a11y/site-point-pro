---
import Bandeau from '../components/Bandeau.astro';
import Base from '../layouts/Base.astro';
import Calculateur from '../components/react/Calculateur.jsx';
import EnTetePage from '../components/EnTetePage.astro';
import Galerie from '../components/vue/Galerie.vue';
import Tarifs from '../components/react/Tarifs.jsx';

const CAT_DOCS = [
  {
    "src": "catalogue-blocs-hourdis.jpg",
    "alt": "Page du catalogue : blocs, agglomérés et hourdis",
    "texte": "Catalogue blocs et hourdis"
  },
  {
    "src": "catalogue-paves-bordures.jpg",
    "alt": "Page du catalogue : pavés et bordures",
    "texte": "Catalogue pavés et bordures"
  }
];
---
<Base page="tarifs" titre="Tarifs — POINT PRO GUINÉE" description="Nos produits et nos prix, issus du catalogue officiel POINT PRO.">
<EnTetePage titre="Tarifs" texte="Nos produits et nos prix, issus du catalogue officiel POINT PRO." image="parpaings-sur-palette.jpg" />
<section class="section soft" id="catalogue"><div class="wrap">
<div class="section-head reveal"><div class="eyebrow">Catalogue officiel · Édition chantier</div><h2>Nos produits et nos tarifs.</h2><p>Prix en francs guinéens (GNF), à l’unité sauf mention contraire. Pour une grande quantité ou une livraison, demandez-nous un devis. <a class="inline-link" href="#calculateur">Combien de briques pour votre mur ?</a></p></div>
<div class="reveal"><Tarifs client:load /></div>
<Galerie client:load classe="cat-docs" images={CAT_DOCS} catalogue />
<p class="note">Tarifs repris du catalogue officiel POINT PRO publié sur notre page Facebook. Ils peuvent évoluer : confirmez le prix au moment de votre commande.</p>
</div></section>
<section class="section" id="calculateur"><div class="wrap">
<div class="section-head reveal"><div class="eyebrow">Calculateur</div><h2>Combien de briques pour votre mur ?</h2><p>Entrez vos mesures en mètres : vous obtenez la quantité à prévoir et une estimation du prix.</p></div>
<div class="reveal"><Calculateur client:load /></div>
<p class="note">Briques de 40 × 20 cm de face, joints de 1 cm. Estimation hors livraison et hors mortier, à confirmer par notre équipe.</p>
</div></section>
<Bandeau />
</Base>
