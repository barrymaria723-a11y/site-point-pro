---
// En-tête, pied de page et style de Maria ; les ajouts sont dans ajouts.css
import '../styles/maria.css';
import '../styles/ajouts.css';
import Devis from '../components/react/Devis.jsx';
const { page = '', titre, description, noindex = false } = Astro.props;
const SITE = Astro.site.href;
const url = SITE + (page ? `${page}.html` : '');
const LIENS = [['entreprise', 'L’entreprise'], ['activites', 'Nos activités'], ['briqueterie', 'Briqueterie'], ['tarifs', 'Tarifs'], ['location-transport', 'Location & transport'], ['realisations', 'Réalisations'], ['contact', 'Contact']];
const fiche = {
  '@context': 'https://schema.org', '@type': 'HomeAndConstructionBusiness', name: 'POINT PRO GUINÉE', slogan: 'On construit vos ambitions',
  description, url: SITE, logo: SITE + 'images/logo-rond.jpg', image: SITE + 'images/logo-rond.jpg',
  telephone: ['+224620776222', '+224625964412'], email: 'pointproguinee@gmail.com',
  address: { '@type': 'PostalAddress', addressLocality: 'Koliagbé', addressCountry: 'GN' }, areaServed: ['Conakry', 'Mamou', 'Kindia'], currenciesAccepted: 'GNF',
};
---
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{titre}</title>
{noindex ? <meta name="robots" content="noindex"> : <>
<meta name="description" content={description}>
<meta property="og:title" content={titre}>
<meta property="og:description" content={description}>
<meta property="og:image" content={SITE + 'images/logo-rond.jpg'}>
<meta property="og:url" content={url}>
<meta property="og:type" content="website">
<meta property="og:locale" content="fr_FR">
<meta name="twitter:card" content="summary">
<link rel="canonical" href={url}>
</>}
<link rel="icon" type="image/png" href="/images/logo-embleme.png">
<link rel="apple-touch-icon" href="/images/logo-embleme.png">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script is:inline>try{if(sessionStorage.getItem("pp-intro"))document.documentElement.classList.add("no-intro");sessionStorage.setItem("pp-intro","1")}catch(e){}</script>
{!page && !noindex && <script is:inline type="application/ld+json" set:html={JSON.stringify(fiche)} />}
</head>
<body>
{!noindex && <><div class="intro" aria-hidden="true"><div class="intro-inner"><picture><source type="image/avif" srcset="/images/logo-embleme.avif"><img src="/images/logo-embleme.png" alt="" width="96" height="96"></picture><span>POINT PRO GUINÉE</span><i></i></div></div></>}
<div class="topbar"><span>Une entreprise au service de vos chantiers en Guinée</span><span>Koliagbé · Conakry · Mamou · Kindia &nbsp;|&nbsp; <a href="tel:+224620776222">+224 620 77 62 22</a> &nbsp;|&nbsp; <a href="mailto:pointproguinee@gmail.com">pointproguinee@gmail.com</a></span></div>

<header class="nav">
<a class="brand" href="/"><picture><source type="image/avif" srcset="/images/logo-embleme.avif"><img class="brandmark" src="/images/logo-embleme.png" alt="Logo POINT PRO" width="56" height="56"></picture><span>POINT PRO GUINÉE<small>ON CONSTRUIT VOS AMBITIONS</small></span></a>
<nav class="navlinks" id="navlinks" aria-label="Navigation principale">{LIENS.map(([id, t]) => <a href={`/${id}.html`} aria-current={page === id ? "page" : undefined}>{t}</a>)}</nav>
<a class="btn" href="/contact.html">Demander un devis ↗</a>
<button class="menu" id="menuBtn" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="navlinks"><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
</header>
<main><slot /></main>
<footer class="footer">
<div class="footer-grid">
<div><a class="brand" href="/"><picture><source type="image/avif" srcset="/images/logo-embleme.avif"><img class="brandmark" src="/images/logo-embleme.png" alt="Logo POINT PRO" width="56" height="56"></picture><span>POINT PRO GUINÉE<small style="color:#9aa6b4">ON CONSTRUIT VOS AMBITIONS</small></span></a><p>Location, transport, briqueterie et matériaux de construction. Un partenaire pour vos projets en Guinée.</p></div>
<div><h4>EXPLORER</h4><p><a href="/entreprise.html">L’entreprise</a><br><a href="/activites.html">Nos activités</a><br><a href="/tarifs.html">Tarifs</a><br><a href="/tarifs.html#calculateur">Calculateur de briques</a><br><a href="/realisations.html">Réalisations</a></p></div>
<div><h4>NOS SERVICES</h4><p><a href="/briqueterie.html">Briqueterie &amp; matériaux</a><br><a href="/location-transport.html#transport">Transport</a><br><a href="/location-transport.html">Location d’engins</a></p></div>
<div><h4>CONTACT</h4><p><a href="tel:+224620776222">+224 620 77 62 22</a><br><a href="tel:+224625964412">+224 625 96 44 12</a><br><a href="mailto:pointproguinee@gmail.com">pointproguinee@gmail.com</a><br>Koliagbé, Guinée<br>Conakry · Mamou · Kindia</p></div>
</div>
<div class="copyright"><span>© 2026 POINT PRO GUINÉE. Tous droits réservés.</span><span>On construit vos ambitions, brique après brique.</span></div>
</footer>
<a class="wa" href="https://wa.me/224620776222" target="_blank" rel="noopener" aria-label="Nous écrire sur WhatsApp"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.7-5A8.5 8.5 0 1 1 8 19.3L3 21z"/></svg>WhatsApp ↗</a>
<Devis client:only="react" />
<script is:inline src="/script.js"></script>
<script>import { demarrerAudience } from '../lib/audience.js'; demarrerAudience();</script>
</body>
</html>
